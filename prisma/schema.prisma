generator client {
      provider = "prisma-client"
      output   = "../generated/prisma"
}

datasource db {
      provider = "postgresql"
}

model User {
      id         String         @id @default(cuid())
      email      String         @unique
      name       String?
      createdAt  DateTime       @default(now())
      updatedAt  DateTime       @updatedAt
      xp         Int            @default(0)
      level      Int            @default(1)
      fullName   String?
      alarmSound String         @default("digital")
      categories Category[]
      sessions   FocusSession[]
      habits     Habit[]
      tasks      Task[]
      timers     Timer[]

      workLogs       WorkLog[]
      xpLogs         XpLog[]
      dailyLogs      DailyLog[]
      reminders      Reminder[]
      nonNegotiables NonNegotiable[]
      projects       Project[]
      notes          Note[]
      calendarEvents CalendarEvent[]
}

model Timer {
      id           String         @id @default(cuid())
      userId       String
      name         String
      duration     Int
      createdAt    DateTime       @default(now())
      color        String         @default("bg-blue-500")
      type         String         @default("FOCUS")
      alarmSoundId String?
      sessions     FocusSession[]
      alarmSound   AlarmSound?    @relation(fields: [alarmSoundId], references: [id])
      user         User           @relation(fields: [userId], references: [id])
}

model AlarmSound {
      id        String   @id @default(cuid())
      userId    String?
      name      String
      url       String
      isCustom  Boolean  @default(false)
      createdAt DateTime @default(now())
      timers    Timer[]
}

model FocusSession {
      id        String    @id @default(cuid())
      userId    String
      startTime DateTime
      endTime   DateTime?
      duration  Int       @default(0)
      status    String    @default("COMPLETED")
      createdAt DateTime  @default(now())
      timerId   String?
      timer     Timer?    @relation(fields: [timerId], references: [id])
      user      User      @relation(fields: [userId], references: [id])
}

model WorkLog {
      id     String   @id @default(cuid())
      userId String
      hours  Float
      type   String
      date   DateTime @default(now())
      user   User     @relation(fields: [userId], references: [id])
}

model Task {
      id          String    @id @default(cuid())
      userId      String
      title       String
      isCompleted Boolean   @default(false)
      dueDate     DateTime?
      createdAt   DateTime  @default(now())
      description String?
      status      String    @default("PENDING")
      updatedAt   DateTime  @updatedAt
      categoryId  String?
      xp          Int       @default(10)
      category    Category? @relation(fields: [categoryId], references: [id])
      user        User      @relation(fields: [userId], references: [id])

      // Project Relations
      sectionId String?
      section   Section?  @relation(fields: [sectionId], references: [id])
      startDate DateTime? // For timeline visualisation
}

model Project {
      id          String       @id @default(cuid())
      userId      String
      title       String
      description String?
      status      String       @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
      startDate   DateTime?
      endDate     DateTime?
      color       String       @default("#3b82f6") // Blue default
      createdAt   DateTime     @default(now())
      updatedAt   DateTime     @updatedAt
      user        User         @relation(fields: [userId], references: [id])
      sections    Section[]
      brainstorms Brainstorm[]
}

model Section {
      id        String    @id @default(cuid())
      projectId String
      title     String
      status    String    @default("PENDING")
      order     Int       @default(0)
      startDate DateTime?
      endDate   DateTime?
      color     String?
      createdAt DateTime  @default(now())
      updatedAt DateTime  @updatedAt
      project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
      tasks     Task[]
}

model Category {
      id             String          @id @default(cuid())
      userId         String
      name           String
      color          String?
      createdAt      DateTime        @default(now())
      user           User            @relation(fields: [userId], references: [id])
      tasks          Task[]
      dailyLogs      DailyLog[]
      calendarEvents CalendarEvent[]
}

model Habit {
      id             String     @id @default(cuid())
      userId         String
      name           String
      streak         Int        @default(0)
      completedDates DateTime[]
      targetDays     Int? // Null for active/daily, value for training
      startDate      DateTime   @default(now())
      archived       Boolean    @default(false)
      updatedAt      DateTime   @updatedAt
      user           User       @relation(fields: [userId], references: [id])
}

model XpLog {
      id          String   @id @default(cuid())
      userId      String
      amount      Int
      source      String
      description String?
      createdAt   DateTime @default(now())
      user        User     @relation(fields: [userId], references: [id])
}

model DailyLog {
      id         String    @id @default(cuid())
      userId     String
      title      String
      content    String    @db.Text
      date       DateTime  @default(now())
      isFavorite Boolean   @default(false)
      createdAt  DateTime  @default(now())
      updatedAt  DateTime  @updatedAt
      user       User      @relation(fields: [userId], references: [id])
      categoryId String?
      category   Category? @relation(fields: [categoryId], references: [id])
}

model Reminder {
      id        String   @id @default(cuid())
      userId    String
      content   String
      createdAt DateTime @default(now())
      user      User     @relation(fields: [userId], references: [id])
}

model NonNegotiable {
      id             String     @id @default(cuid())
      userId         String
      title          String
      completedDates DateTime[]
      createdAt      DateTime   @default(now())
      user           User       @relation(fields: [userId], references: [id])
}

model CalendarEvent {
      id          String       @id @default(cuid())
      userId      String
      title       String
      start       DateTime
      end         DateTime
      allDay      Boolean
      color       String
      categoryId  String?
      recurrence  String       @default("NONE") // NONE, WEEKLY, MONTHLY
      isCompleted Boolean      @default(false)
      category    Category?    @relation(fields: [categoryId], references: [id])
      user        User         @relation(fields: [userId], references: [id])
      brainstorms Brainstorm[]
}

model Brainstorm {
      id              String         @id @default(cuid())
      name            String         @default("Untitled Brainstorm")
      projectId       String
      project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
      content         Json? // Stores { elements, appState, files }
      createdAt       DateTime       @default(now())
      updatedAt       DateTime       @updatedAt
      calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])
      calendarEventId String?
}

enum NoteType {
      FOLDER
      CANVAS
}

model Note {
      id        String   @id @default(cuid())
      userId    String
      title     String
      type      NoteType @default(FOLDER)
      content   Json? // Stores Excalidraw data if type == CANVAS
      parentId  String?
      parent    Note?    @relation("NoteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
      children  Note[]   @relation("NoteHierarchy")
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt
      user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
