generator client {
      provider = "prisma-client"
      output   = "../generated/prisma"
}

datasource db {
      provider = "postgresql"
}

model User {
      id             String          @id @default(cuid())
      email          String          @unique
      name           String?
      createdAt      DateTime        @default(now())
      updatedAt      DateTime        @updatedAt
      xp             Int             @default(0)
      level          Int             @default(1)
      fullName       String?
      alarmSound     String          @default("digital")
      calendarEvents CalendarEvent[]
      categories     Category[]
      dailyLogs      DailyLog[]
      sessions       FocusSession[]
      habits         Habit[]
      keyLearnings   KeyLearning[]
      nonNegotiables NonNegotiable[]
      notes          Note[]
      patterns       Pattern[]
      problemLogs    ProblemLog[]
      projects       Project[]
      reminders      Reminder[]
      tags           Tag[]
      tasks          Task[]
      timers         Timer[]
      workLogs       WorkLog[]
      xpLogs         XpLog[]
}

model Timer {
      id           String         @id @default(cuid())
      userId       String
      name         String
      duration     Int
      createdAt    DateTime       @default(now())
      color        String         @default("bg-blue-500")
      type         String         @default("FOCUS")
      alarmSoundId String?
      sessions     FocusSession[]
      alarmSound   AlarmSound?    @relation(fields: [alarmSoundId], references: [id])
      user         User           @relation(fields: [userId], references: [id])
}

model AlarmSound {
      id        String   @id @default(cuid())
      userId    String?
      name      String
      url       String
      isCustom  Boolean  @default(false)
      createdAt DateTime @default(now())
      timers    Timer[]
}

model FocusSession {
      id        String    @id @default(cuid())
      userId    String
      startTime DateTime
      endTime   DateTime?
      duration  Int       @default(0)
      status    String    @default("COMPLETED")
      createdAt DateTime  @default(now())
      timerId   String?
      timer     Timer?    @relation(fields: [timerId], references: [id])
      user      User      @relation(fields: [userId], references: [id])
}

model WorkLog {
      id     String   @id @default(cuid())
      userId String
      hours  Float
      type   String
      date   DateTime @default(now())
      user   User     @relation(fields: [userId], references: [id])
}

model Task {
      id          String    @id @default(cuid())
      userId      String
      title       String
      isCompleted Boolean   @default(false)
      dueDate     DateTime?
      createdAt   DateTime  @default(now())
      description String?
      status      String    @default("PENDING")
      updatedAt   DateTime  @updatedAt
      categoryId  String?
      xp          Int       @default(10)
      sectionId   String?
      startDate   DateTime?
      category    Category? @relation(fields: [categoryId], references: [id])
      section     Section?  @relation(fields: [sectionId], references: [id])
      user        User      @relation(fields: [userId], references: [id])
}

model Project {
      id          String       @id @default(cuid())
      userId      String
      title       String
      description String?
      status      String       @default("ACTIVE")
      startDate   DateTime?
      endDate     DateTime?
      color       String       @default("#3b82f6")
      createdAt   DateTime     @default(now())
      updatedAt   DateTime     @updatedAt
      brainstorms Brainstorm[]
      user        User         @relation(fields: [userId], references: [id])
      sections    Section[]
}

model Section {
      id        String    @id @default(cuid())
      projectId String
      title     String
      status    String    @default("PENDING")
      order     Int       @default(0)
      startDate DateTime?
      endDate   DateTime?
      color     String?
      createdAt DateTime  @default(now())
      updatedAt DateTime  @updatedAt
      project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
      tasks     Task[]
}

model Category {
      id             String          @id @default(cuid())
      userId         String
      name           String
      color          String?
      createdAt      DateTime        @default(now())
      calendarEvents CalendarEvent[]
      user           User            @relation(fields: [userId], references: [id])
      dailyLogs      DailyLog[]
      keyLearnings   KeyLearning[]
      patterns       Pattern[]
      problemLogs    ProblemLog[]
      tags           Tag[]
      tasks          Task[]
}

model Habit {
      id             String     @id @default(cuid())
      userId         String
      name           String
      streak         Int        @default(0)
      completedDates DateTime[]
      archived       Boolean    @default(false)
      startDate      DateTime   @default(now())
      targetDays     Int?
      updatedAt      DateTime   @updatedAt
      user           User       @relation(fields: [userId], references: [id])
}

model XpLog {
      id          String   @id @default(cuid())
      userId      String
      amount      Int
      source      String
      description String?
      createdAt   DateTime @default(now())
      user        User     @relation(fields: [userId], references: [id])
}

model DailyLog {
      id         String    @id @default(cuid())
      userId     String
      title      String
      content    String
      date       DateTime  @default(now())
      isFavorite Boolean   @default(false)
      createdAt  DateTime  @default(now())
      updatedAt  DateTime  @updatedAt
      categoryId String?
      category   Category? @relation(fields: [categoryId], references: [id])
      user       User      @relation(fields: [userId], references: [id])
}

model Reminder {
      id        String   @id @default(cuid())
      userId    String
      content   String
      createdAt DateTime @default(now())
      user      User     @relation(fields: [userId], references: [id])
}

model NonNegotiable {
      id             String     @id @default(cuid())
      userId         String
      title          String
      completedDates DateTime[]
      createdAt      DateTime   @default(now())
      user           User       @relation(fields: [userId], references: [id])
}

model CalendarEvent {
      id          String       @id @default(cuid())
      userId      String
      title       String
      start       DateTime
      end         DateTime
      allDay      Boolean
      color       String
      categoryId  String?
      isCompleted Boolean      @default(false)
      recurrence  String       @default("NONE")
      brainstorms Brainstorm[]
      category    Category?    @relation(fields: [categoryId], references: [id])
      user        User         @relation(fields: [userId], references: [id])
}

model Brainstorm {
      id              String         @id @default(cuid())
      name            String         @default("Untitled Brainstorm")
      projectId       String
      content         Json?
      createdAt       DateTime       @default(now())
      updatedAt       DateTime       @updatedAt
      calendarEventId String?
      calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])
      project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Note {
      id        String   @id @default(cuid())
      userId    String
      title     String
      type      NoteType @default(FOLDER)
      content   Json?
      parentId  String?
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt
      parent    Note?    @relation("NoteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
      children  Note[]   @relation("NoteHierarchy")
      user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProblemLog {
      id                          String        @id @default(cuid())
      problem_name                String
      problem_link                String
      platform                    String
      contest_id                  String?
      rating                      Int
      pattern_subtype             String?
      solve_status_type           String
      idea_source                 String
      attempt_count               Int
      time_to_first_idea_minutes  Int
      implementation_time_minutes Int
      debug_time_minutes          Int
      total_time_minutes          Int
      perceived_difficulty_before Int
      perceived_difficulty_after  Int
      mental_load_score           Int
      stress_level_during         Int
      failure_categories          String[]
      mistakes_text               String
      edge_cases_found            String?
      invariant_or_key_property   String?
      final_verdict               String?
      core_tricks_used            String[]
      template_used               Boolean
      template_name               String?
      created_at                  DateTime      @default(now())
      last_revised_date           DateTime?
      must_revisit                Boolean
      rev_level                   Int           @default(0)
      re_solve_result             String?
      pattern_generalization_note String
      similar_problems_links      String[]
      userId                      String
      categoryId                  String?
      code_snippets               Json?
      learning_from_failure       String?
      category                    Category?     @relation(fields: [categoryId], references: [id])
      user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
      keyLearnings                KeyLearning[] @relation("KeyLearningToProblemLog")
      tags                        Tag[]         @relation("ProblemLogToTag")
      patterns                    Pattern[]     @relation("PatternToProblemLog")
}

model Tag {
      id          String       @id @default(cuid())
      name        String
      userId      String
      categoryId  String?
      category    Category?    @relation(fields: [categoryId], references: [id])
      user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
      problemLogs ProblemLog[] @relation("ProblemLogToTag")

      @@unique([userId, name])
}

model Pattern {
      id          String       @id @default(cuid())
      name        String
      userId      String
      categoryId  String?
      category    Category?    @relation(fields: [categoryId], references: [id])
      user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
      problemLogs ProblemLog[] @relation("PatternToProblemLog")

      @@unique([userId, name])
}

model KeyLearning {
      id          String       @id @default(cuid())
      point       String
      userId      String
      categoryId  String?
      category    Category?    @relation(fields: [categoryId], references: [id])
      user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
      problemLogs ProblemLog[] @relation("KeyLearningToProblemLog")

      @@unique([userId, point])
}

enum NoteType {
      FOLDER
      CANVAS
}
